# Cloudinary Configurations (For product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 Storage Configurations (Optional, fallback to local/cloudinary)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name

# Supabase Configurations (Database storage and persistent transactions)
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Stellar Network Soroban Contract IDs (Optional - defaults to Testnet values)
NEXT_PUBLIC_STELLAR_CAMPAIGN_CONTRACT_ID=your_campaign_contract_id
NEXT_PUBLIC_STELLAR_USDC_CONTRACT_ID=your_usdc_sac_contract_id

