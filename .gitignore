# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust build artifacts (ALL)
/target/
**/target/

# Unnecessary files
/node.tar.xz
/node/
Cargo.lock

# Local encrypted uploads (test data, not for production)
/public/uploads/

# Legacy local JSON data (migrated to Supabase)
/data/

# Zone.Identifier files (Windows/WSL artifact)
*Zone.Identifier

# Root-level duplicate assets (originals are in /public)
/Logo.png
/Logo2.png
/MockProducts.png

# Local dev helper script (machine-specific paths)
/run_dev.sh
